{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Console Editor",
            "type": "shell",
            "command": "g++",
            "args": [
                "-o",
                "texteditor.exe",
                "texteditor.cpp"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build GUI Editor",
            "type": "shell",
            "command": "g++",
            "args": [
                "-DUNICODE",
                "-D_UNICODE",
                "-o",
                "texteditor_gui.exe",
                "texteditor_gui.cpp",
                "-lgdi32",
                "-lcomdlg32",
                "-mwindows"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}